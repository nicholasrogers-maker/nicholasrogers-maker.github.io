---
import Base from '../layouts/Base.astro';
import ShowOutput from '../components/ShowOutput.astro';
import EntryCards from '../components/EntryCards.astro';
import SocConsole from '../components/SocConsole.astro';
import { profile } from '../data/profile';
import { acl } from '../data/security';
import { getLabs, getPosts } from '../lib/content';

const [labs, posts] = await Promise.all([getLabs(), getPosts()]);
const items = [...labs, ...posts]
  .filter((e) => e.data.track === 'security')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const platforms = profile.links.filter((l) => ['tryhackme', 'hackthebox'].includes(l.id) && l.url);
---

<Base title="Security" description="Cyber security work: packet analysis, hardening, CTF write-ups.">
  <ShowOutput
    cmd="show logging | include %SEC"
    title="Security"
    as="h1"
    lead="Where networking meets cyber security. Below is a simulated SOC feed: pick an alert to see how I'd detect and respond to it."
  >
    <SocConsole />
  </ShowOutput>

  <ShowOutput cmd="show access-lists SECURITY-FOCUS" title="What I focus on">
    <div class="panel acl mono">
      <div class="h">Extended IP access list SECURITY-FOCUS</div>
      {
        acl.map((a) => (
          <div class="row">
            {'    '}
            {a.seq} <span class={a.action}>{a.action}</span> {a.rule.padEnd(24)} <span class="n">! {a.note}</span>
          </div>
        ))
      }
    </div>

    {
      platforms.length > 0 && (
        <div class="btn-row platforms">
          {platforms.map((p) => (
            <a class="btn ghost" href={p.url} target="_blank" rel="noopener">
              {p.label} profile →
            </a>
          ))}
        </div>
      )
    }
    <p class="ctf-hint mono">🏴 There's a flag hidden on this site. Open the CLI (<kbd>`</kbd>) and type <code>ctf</code>.</p>
  </ShowOutput>

  <ShowOutput cmd="dir flash:/security/" title="Security write-ups">
    <EntryCards items={items} empty="No security write-ups yet. Set the track to Security in the editor to list one here." />
  </ShowOutput>
</Base>

<style>
  .acl {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.8;
    overflow-x: auto;
  }
  .acl .h {
    color: var(--text);
  }
  .acl .row {
    white-space: pre;
  }
  .permit {
    color: var(--green);
  }
  .deny {
    color: var(--red);
  }
  .n {
    color: var(--faint);
  }
  .platforms {
    margin-top: 1.5rem;
  }
  .ctf-hint {
    margin-top: 1.5rem;
    font-size: 0.85rem;
    color: var(--dim);
  }
  .ctf-hint code {
    color: var(--green);
  }
</style>
