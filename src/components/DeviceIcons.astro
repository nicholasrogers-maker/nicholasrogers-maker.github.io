---
// Shared network device symbols (Packet Tracer / Cisco diagram style).
// Used with <use href="#ic-router" />. Rendered once per page by the layout.
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <symbol id="ic-router" viewBox="0 0 64 64">
      <ellipse cx="32" cy="38" rx="24" ry="10" class="dev-body"></ellipse>
      <path d="M8 26v12M56 26v12" class="dev-line"></path>
      <ellipse cx="32" cy="26" rx="24" ry="10" class="dev-body"></ellipse>
      <path d="M20 22l8 3-8 3M44 24l-8 3 8 3M30 18l4 4 4-4M30 34l4-4 4 4" class="dev-line" transform="translate(-2 0)"></path>
    </symbol>
    <symbol id="ic-switch" viewBox="0 0 64 64">
      <rect x="6" y="20" width="52" height="26" rx="3" class="dev-body"></rect>
      <path d="M14 29h30l-5-4M50 37H20l5 4" class="dev-line"></path>
    </symbol>
    <symbol id="ic-firewall" viewBox="0 0 64 64">
      <rect x="8" y="12" width="48" height="40" rx="2" class="dev-body"></rect>
      <path d="M8 25h48M8 38h48M24 12v13M40 12v13M16 25v13M32 25v13M48 25v13M24 38v14M40 38v14" class="dev-line"></path>
    </symbol>
    <symbol id="ic-server" viewBox="0 0 64 64">
      <rect x="16" y="6" width="32" height="52" rx="3" class="dev-body"></rect>
      <path d="M22 16h20M22 24h20M22 32h20" class="dev-line"></path>
      <circle cx="40" cy="48" r="2.5" class="dev-led"></circle>
    </symbol>
    <symbol id="ic-pc" viewBox="0 0 64 64">
      <rect x="8" y="10" width="48" height="32" rx="3" class="dev-body"></rect>
      <rect x="13" y="15" width="38" height="22" rx="1" class="dev-screen"></rect>
      <path d="M26 42l-3 10h18l-3-10M18 54h28" class="dev-line"></path>
    </symbol>
    <symbol id="ic-laptop" viewBox="0 0 64 64">
      <rect x="12" y="14" width="40" height="26" rx="2" class="dev-body"></rect>
      <rect x="16" y="18" width="32" height="18" rx="1" class="dev-screen"></rect>
      <path d="M4 46h56l-4 6H8z" class="dev-body"></path>
    </symbol>
    <symbol id="ic-cloud" viewBox="0 0 64 64">
      <path
        d="M18 48h30a11 11 0 0 0 1-22 15 15 0 0 0-28-4 12 12 0 0 0-3 26z"
        class="dev-body"></path>
    </symbol>
  </defs>
</svg>

<style is:global>
  .dev-body {
    fill: var(--panel-2);
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linejoin: round;
  }
  .dev-line {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .dev-screen {
    fill: var(--bg);
    stroke: currentColor;
    stroke-width: 1.2;
    opacity: 0.8;
  }
  .dev-led {
    fill: var(--green);
  }
</style>
