---
import { profile, activeLinks } from '../data/profile';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <pre class="cfg" aria-hidden="true">Building configuration...
[OK]
!
end</pre>
    <div class="row">
      <p>© {year} {profile.name}</p>
      <ul>
        {
          activeLinks.map((l) => (
            <li>
              <a href={l.url} rel="noopener" target="_blank">
                {l.label}
              </a>
            </li>
          ))
        }
        <li><a href={`mailto:${profile.email}`}>Email</a></li>
      </ul>
      <p class="hint">Press <kbd>`</kbd> to open the CLI. Try <code>show version</code>.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding: 2rem 0 3rem;
    font-size: 0.85rem;
    color: var(--faint);
  }
  .cfg {
    margin: 0 0 1rem;
    color: var(--faint);
    font-size: 0.8rem;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    align-items: center;
    justify-content: space-between;
  }
  .row p {
    margin: 0;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    color: var(--dim);
  }
  .hint code {
    color: var(--green);
  }
</style>
