---
import { profile } from '../data/profile';
import { url } from '../lib/url';

const nav = [
  { href: url('about/'), label: 'about' },
  { href: url('certifications/'), label: 'certs' },
  { href: url('labs/'), label: 'labs' },
  { href: url('security/'), label: 'security' },
  { href: url('blog/'), label: 'blog' },
  { href: url('contact/'), label: 'contact' },
];
const path = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => {
  const h = href.replace(/\/$/, '');
  return path === h || path.startsWith(h + '/');
};
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={url()} aria-label={`${profile.name}, home`}>
      <span class="host">{profile.hostname}</span><span class="hash">#</span><span class="cursor" aria-hidden="true"></span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((n) => (
            <li>
              <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>
                {n.label}
              </a>
            </li>
          ))
        }
        <li>
          <button class="cli-btn" type="button" data-cli-toggle aria-label="Open command line">
            &gt;_ cli
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 0.75rem;
  }
  .brand {
    font: 600 1rem var(--mono);
    color: var(--green);
    text-decoration: none;
    white-space: nowrap;
  }
  .brand .hash {
    color: var(--text);
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font: 0.88rem var(--mono);
  }
  nav a {
    color: var(--dim);
    text-decoration: none;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--green);
  }
  nav a[aria-current='page']::before {
    content: '*';
    color: var(--green);
    margin-right: 2px;
  }
  .cli-btn {
    font: inherit;
    color: var(--green);
    background: var(--panel);
    border: 1px solid var(--line-2);
    border-radius: 4px;
    padding: 0 0.45rem;
    cursor: pointer;
  }
  .cli-btn:hover {
    border-color: var(--green);
  }
</style>
